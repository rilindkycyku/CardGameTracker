  "game": "Kosovo Bridge (Gin Rummy variant)",
  "scoring_rules": {
    "objective": "Lowest cumulative total across rounds wins the game. Each player starts a round with 14 cards and must form melds summing to 51+ points to lay down / go out.",
    "player_states_per_round": {
      "closed": "Player has not laid down or sold any card to another player this round.",
      "opened": "Player has laid down at least one meld or sold a card to another player this round."
    },
    "round_outcomes": [
      {
        "id": "hant",
        "name": "Hant (cold close)",
        "condition": "The closing player reaches 51 and closes the round without ever having laid a card or sold a card to anyone.",
        "closer_score": -40,
        "others": [
          {
            "condition": "other player is still 'closed' (never laid/sold a card)",
            "score": 200
          },
          {
            "condition": "other player had already 'opened' (laid at least one card)",
            "score_formula": "2 * sum(point value of cards remaining in that player's hand)"
          }
        ]
      },
      {
        "id": "normal_close",
        "name": "Normal close",
        "condition": "The closing player had already laid a card or sold a card to someone before closing.",
        "closer_score": -20,
        "others": [
          {
            "condition": "other player is still 'closed' (never laid/sold a card)",
            "score": 100
          },
          {
            "condition": "other player had already 'opened' (laid at least one card)",
            "score_formula": "sum(point value of cards remaining in that player's hand)"
          }
        ]
      }
    ],
    "notes": [
      "The per-round 'scores' values already stored in each group's `rounds` array are the outcomes of applying these rules \u2014 not entered independently.",
      "Card point values (per rank/suit) were not specified and are not yet encoded here; needed to compute 'sum of cards remaining in hand' from an actual hand rather than from the already-recorded round score."
    ]
  }
