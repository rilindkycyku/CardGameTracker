{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    /*
     * Parathënja `.ts` te importet rishkruhet `.js` kur dikush e nxjerr kodin.
     *
     * Projekti i shkruan importet me `.ts` sepse `node --test` i lexon modulet
     * drejtpërdrejt (pika 1), dhe ai kërkon shtegun e plotë. Vercel-i nga ana e
     * vet e përkthen `api/sinjali.ts` te `.js` **pa i prekur specifikuesit** —
     * pra dilte një funksion që importonte `../src/takimi.ts`, skedar që te
     * dalja nuk ekziston, dhe botimi refuzohej. Kjo e mban një stil të vetëm te
     * burimi dhe e ndreq daljen.
     */
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["api", "src", "test", "vite.config.ts", "vite.punetori.config.ts"]
}
